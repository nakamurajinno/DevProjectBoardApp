NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# true にすると Supabase を使わずインメモリのモックデータ + デモアカウントで動作する (UI 確認用)
# デモアカウント: admin@example.com / editor@example.com / viewer@example.com (デモ組織)、other@example.com (別の組織) (パスワード: password)
# USE_MOCK_REPOSITORY=true

# Supabase の service_role キー (Project Settings > API Keys)。サーバー専用・公開しないこと。
# 招待メールの送信 (auth.admin.inviteUserByEmail) と、ログイン時の「ユーザーが見つかりません」の判定に使う。
# 未設定の場合、招待はメールを送らずに招待リンク (招待コード) を発行するだけになる。
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
